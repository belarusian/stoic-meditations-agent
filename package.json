{
  "name": "stoic-meditations-agent",
  "version": "1.0.0",
  "description": "An A2A protocol-based AI agent that uses Marcus Aurelius' Meditations with RAG (ChromaDB) to provide Stoic philosophy dialogue via Genkit and OpenAI-compatible LLMs.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/agent.js",
    "build:server": "tsc",
    "build:client": "cd client && node build.mjs",
    "build": "tsc && cd client && node build.mjs",
    "dev": "ts-node src/agent.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/belarusian/stoic-meditations-agent.git"
  },
  "keywords": [
    "stoic",
    "philosophy",
    "marcus-aurelius",
    "meditations",
    "ai-agent",
    "a2a-protocol",
    "genkit",
    "rag",
    "chromadb",
    "llama-cpp",
    "openai-compatible",
    "web-app",
    "dialogue-agent"
  ],
  "author": "belarusian",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/belarusian/stoic-meditations-agent/issues"
  },
  "homepage": "https://github.com/belarusian/stoic-meditations-agent#readme",
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@genkit-ai/compat-oai": "^1.35.0",
    "chromadb": "^1.8.1",
    "chromadb-default-embed": "^2.14.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "genkit": "^1.35.0",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "esbuild": "^0.28.0",
    "execa": "^9.6.1",
    "got": "^15.0.5",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
